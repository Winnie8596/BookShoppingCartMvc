# copy to .env on the server and fill in. never commit .env

# domain pointing at this server (A record). use :80 to test over plain http by ip
DOMAIN=shop.example.com

# hosts the app answers to, defaults to DOMAIN. set to * when testing by ip
ALLOWED_HOSTS=

# sql server sa password: 8+ chars, upper, lower, digit, symbol. no ; in it
MSSQL_SA_PASSWORD=

# admin login, defaults to admin@gmail.com. only used the first time the database is created
ADMIN_EMAIL=
ADMIN_PASSWORD=

# optional, leave empty to turn the book assistant off
GEMINI_API_KEY=
