@model GenreDTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Rename genre";
}
<div class="col-12 col-lg-8 col-xl-6">
    <a asp-action="Index" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to genres</a>
    <h1 class="h3 my-2">Rename genre</h1>
    <form asp-action="UpdateGenre" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="GenreName" class="form-label">Genre name *</label>
            <input asp-for="GenreName" class="form-control" maxlength="40" required />
            <span asp-validation-for="GenreName" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>
