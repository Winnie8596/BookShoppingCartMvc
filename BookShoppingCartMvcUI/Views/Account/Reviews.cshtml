@model List<MyReviewModel>
@using System.Globalization
@{
    ViewData["Title"] = "My reviews";
    ViewData["AccountSection"] = "Reviews";
    Layout = "_AccountLayout";
    string Stars(int rating) => new string('★', rating) + new string('☆', Review.MaxRating - rating);
    string Date(DateTime d) => d.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    var returnUrl = Url.Action("Reviews", "Account");
}

<h1 class="h3 mb-3">My reviews</h1>

@if (Model.Any())
{
    @foreach (var review in Model)
    {
        <article class="card mb-3 my-review">
            <div class="card-body d-flex gap-3">
                <a asp-controller="Home" asp-action="Details" asp-route-id="@review.BookId" tabindex="-1" aria-hidden="true" class="review-cover flex-shrink-0 d-none d-sm-block">
                    <img src="/images/@(string.IsNullOrEmpty(review.Image) ? "NoImage.png" : review.Image)" alt="" width="60" height="90" loading="lazy" />
                </a>
                <div class="flex-grow-1">
                    <h2 class="h6 mb-1"><a asp-controller="Home" asp-action="Details" asp-route-id="@review.BookId">@review.BookName</a></h2>
                    <div>
                        <span class="text-warning" role="img" aria-label="@review.Rating out of 5 stars">@Stars(review.Rating)</span>
                        @if (!string.IsNullOrEmpty(review.Title))
                        {
                            <strong class="ms-1 review-title">@review.Title</strong>
                        }
                    </div>
                    <p class="mt-2 mb-2 review-comment" style="white-space:pre-line">@review.Comment</p>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted me-auto">
                            @Date(review.CreatedAt)
                            @if (review.UpdatedAt is DateTime updated)
                            {
                                <text>· edited @Date(updated)</text>
                            }
                        </span>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Review" asp-action="Edit" asp-route-bookId="@review.BookId"
                           aria-label="Edit your review of @review.BookName">Edit</a>
                        <form asp-controller="Review" asp-action="Delete" method="post" onsubmit="return confirm('Delete your review?');">
                            <input type="hidden" name="bookId" value="@review.BookId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete your review of @review.BookName">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </article>
    }
}
else
{
    <div class="empty-state text-center py-5" id="no-reviews">
        <i class="bi bi-star display-4 text-muted" aria-hidden="true"></i>
        <h2 class="h5 mt-3">You haven't written any reviews yet.</h2>
        <p class="text-muted">Once you've bought a book, you can rate and review it from its page.</p>
        <a class="btn btn-primary" asp-controller="UserOrder" asp-action="UserOrders">See my orders</a>
    </div>
}
