@using BookShoppingCartMvcUI.Ai
@{
    ViewData["Title"] = "Book assistant";
    var examples = new[] { "Programming books under RM50", "A thriller that's in stock", "What do you have by Robert Martin?" };
}
<div class="assistant mx-auto">
    <h1 class="h3 mb-1"><i class="bi bi-chat-square-text" aria-hidden="true"></i> Book assistant</h1>
    <p class="text-muted mb-3">Ask me about our books. I can only see what's in our catalog, so check the book page before you buy.</p>

    <form asp-action="Ask" method="post" id="assistantForm" novalidate>
        <label class="form-label fw-semibold" for="question">Your question</label>
        <textarea class="form-control" id="question" name="question" rows="3" maxlength="@BookAssistant.MaxQuestionLength"
                  placeholder="e.g. I'm looking for a beginner programming book" aria-describedby="questionHelp questionError" autocomplete="off"></textarea>
        <div class="invalid-feedback" id="questionError"></div>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <p class="form-text my-0 me-auto" id="questionHelp">
                Press Enter to ask, Shift+Enter for a new line. <span id="questionCount">0</span>/@BookAssistant.MaxQuestionLength
            </p>
            <button type="submit" class="btn btn-success" id="askButton">
                <i class="bi bi-send" aria-hidden="true"></i> Ask
            </button>
        </div>
    </form>

    <div class="mt-3">
        <p class="small fw-semibold mb-1" id="examplesLabel">Try asking</p>
        <div class="d-flex flex-wrap gap-2" role="group" aria-labelledby="examplesLabel">
            @foreach (var example in examples)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" data-example>@example</button>
            }
        </div>
    </div>

    @* read out when the answer or an error shows up *@
    <p class="visually-hidden" id="assistantStatus" role="status"></p>

    <div class="alert alert-danger mt-4 mb-0" id="assistantError" hidden></div>

    <section class="card mt-4" id="assistantAnswerBox" aria-labelledby="answerHeading" hidden>
        <div class="card-body">
            <h2 class="h5" id="answerHeading"><i class="bi bi-chat-left-dots" aria-hidden="true"></i> Assistant</h2>
            <p class="assistant-answer mb-0" id="assistantAnswer"></p>
        </div>
    </section>

    <section class="mt-4" id="assistantBooks" aria-labelledby="booksHeading" hidden>
        <h2 class="h5" id="booksHeading">Books from our catalog</h2>
        <ul class="list-group" id="assistantBookList"></ul>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById("assistantForm");
            var question = document.getElementById("question");
            var questionError = document.getElementById("questionError");
            var count = document.getElementById("questionCount");
            var button = document.getElementById("askButton");
            var status = document.getElementById("assistantStatus");
            var errorBox = document.getElementById("assistantError");
            var answerBox = document.getElementById("assistantAnswerBox");
            var answer = document.getElementById("assistantAnswer");
            var booksBox = document.getElementById("assistantBooks");
            var bookList = document.getElementById("assistantBookList");
            var buttonHtml = button.innerHTML;
            var busy = false;

            var maxLength = @BookAssistant.MaxQuestionLength;
            var emptyMessage = @Json.Serialize(BookAssistant.EmptyQuestionMessage);
            var tooLongMessage = @Json.Serialize(BookAssistant.TooLongMessage);
            var failedMessage = "Sorry, something went wrong. Please try again.";
            var offlineMessage = "Could not reach the assistant. Please check your connection and try again.";

            function updateCount() {
                count.textContent = question.value.length;
            }

            function showFieldError(text) {
                questionError.textContent = text;
                question.classList.add("is-invalid");
                question.setAttribute("aria-invalid", "true");
                question.focus();
            }

            function clearFieldError() {
                questionError.textContent = "";
                question.classList.remove("is-invalid");
                question.removeAttribute("aria-invalid");
            }

            function setBusy(on) {
                busy = on;
                button.disabled = on;
                form.setAttribute("aria-busy", on ? "true" : "false");
                button.innerHTML = on
                    ? '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Thinking…'
                    : buttonHtml;
                if (on) status.textContent = "Looking for books…";
            }

            // everything from the server goes in with textContent, never innerHTML
            function showBooks(books) {
                bookList.replaceChildren();
                (books || []).forEach(function (book) {
                    var item = document.createElement("li");
                    item.className = "list-group-item d-flex flex-wrap justify-content-between align-items-start gap-2";

                    var info = document.createElement("div");
                    var link = document.createElement("a");
                    link.href = book.url;
                    link.className = "fw-semibold";
                    link.textContent = book.title;
                    var meta = document.createElement("p");
                    meta.className = "small text-muted mb-0";
                    meta.textContent = "by " + book.author + " · " + book.genre;
                    info.append(link, meta);

                    var side = document.createElement("div");
                    side.className = "text-end";
                    var price = document.createElement("p");
                    price.className = "fw-semibold mb-0";
                    price.textContent = book.price;
                    var stock = document.createElement("p");
                    stock.className = "small mb-0 " + (book.stock === "Out of Stock" ? "text-danger" : "text-success");
                    stock.textContent = book.stock;
                    side.append(price, stock);

                    item.append(info, side);
                    bookList.append(item);
                });
                booksBox.hidden = bookList.children.length === 0;
            }

            function showError(text, books) {
                errorBox.textContent = text;
                errorBox.hidden = false;
                answerBox.hidden = true;
                showBooks(books);
                status.textContent = text;
            }

            async function readJson(response) {
                try { return await response.json(); }
                catch { return null; }
            }

            async function ask() {
                if (busy) return;

                var text = question.value.trim();
                if (text.length === 0) { showFieldError(emptyMessage); return; }
                if (text.length > maxLength) { showFieldError(tooLongMessage); return; }
                clearFieldError();

                setBusy(true);
                errorBox.hidden = true;
                try {
                    var response = await fetch(form.action, { method: "POST", body: new FormData(form) });
                    var data = await readJson(response);

                    if (response.ok && data) {
                        answer.textContent = data.answer;
                        answerBox.hidden = false;
                        showBooks(data.books);
                        status.textContent = "The assistant answered.";
                    }
                    else if (response.status === 400 && data && data.error) {
                        showFieldError(data.error);
                        status.textContent = data.error;
                    }
                    else {
                        showError(data && data.error ? data.error : failedMessage, data && data.books);
                    }
                }
                catch (err) {
                    console.log(err);
                    showError(offlineMessage);
                }
                finally {
                    setBusy(false);
                }
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                ask();
            });

            // enter asks, shift+enter is a new line. skip while an ime is composing
            question.addEventListener("keydown", function (e) {
                if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
                    e.preventDefault();
                    ask();
                }
            });

            question.addEventListener("input", function () {
                updateCount();
                if (question.classList.contains("is-invalid")) clearFieldError();
            });

            document.querySelectorAll("[data-example]").forEach(function (example) {
                example.addEventListener("click", function () {
                    question.value = example.textContent.trim();
                    updateCount();
                    clearFieldError();
                    question.focus();
                });
            });

            updateCount();
        })();
    </script>
}
